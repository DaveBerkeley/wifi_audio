]

# Filter source files based on configuration
if not env['fixed_point']:
    # For floating point, exclude fixed-point specific files
    opus_sources = [s for s in opus_sources if 'fixed' not in s.lower()]
else:
    # For fixed-point, we want the fixed-point SILK implementation
    # The code above already includes fixed-point files when configured
    pass

# Build static library
libopus = env.StaticLibrary(
    target=os.path.join(BUILD_DIR, 'libopus'),
    source=opus_sources
)

Return('libopus')

