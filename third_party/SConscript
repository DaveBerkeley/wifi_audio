import os
from pathlib import Path

# Environment setup with custom options
env = Environment(
    ENV=os.environ,
    tools=['gcc', 'g++', 'ar', 'as'],
    toolpath=[]
)

# Allow command-line overrides
opts = Variables()
opts.Add(EnumVariable('debug', 'Build with debug symbols', 'no', 
                      allowed_values=('yes', 'no')))
opts.Add(PathVariable('PREFIX', 'Installation prefix', '/usr/local'))
opts.Add(BoolVariable('fixed_point', 'Use fixed-point implementation (for embedded)', 1))
opts.Add(BoolVariable('float_approx', 'Use float approximations', 0))
opts.Add(BoolVariable('custom_modes', 'Enable custom modes', 1))
opts.Add(BoolVariable('asm', 'Enable assembly optimizations', 1))
opts.Add(BoolVariable('rtcd', 'Enable runtime CPU detection', 1))
opts.Add('EXTRA_CFLAGS', 'Additional C compiler flags', '')

# Apply options to environment
opts.Update(env)
Help(opts.GenerateHelpText(env))

# Platform detection
is_linux = os.name == 'posix'
is_esp32 = 'ESP32' in os.environ.get('IDF_TARGET', '')

# Determine library paths
OPUS_SRC_DIR = 'opus'  # Directory containing Opus source
BUILD_DIR = 'build'
INSTALL_DIR = env['PREFIX']

# Create build directory if it doesn't exist
if not os.path.exists(BUILD_DIR):
    os.makedirs(BUILD_DIR)

# Base compiler flags
base_cflags = [
    '-O2' if env['debug'] == 'no' else '-O0 -g',
    '-Wall',
    '-Wextra',
    '-Wno-unused-parameter',
    '-Wno-maybe-uninitialized',
    '-std=c99',  # Opus requires C99
    '-DHAVE_CONFIG_H',
    '-DUSE_ALLOCA',
]

# Fixed-point configuration (critical for ESP32)
base_cflags.append('-DFIXED_POINT=1')
if env['float_approx']:
    base_cflags.append('-DFLOAT_APPROX=1')

# Feature flags
if env['custom_modes']:
    base_cflags.append('-DCUSTOM_MODES=1')

if env['asm']:
    if is_linux:
        base_cflags.append('-DOPUS_HAVE_RTCD=1')
    elif is_esp32:
        # ESP32-specific assembly optimizations
        base_cflags.extend(['-DOPUS_HAVE_RTCD=1', '-DUSE_SSE=0'])

if not env['rtcd']:
    base_cflags.append('-DOPUS_DISABLE_RTCD=1')

# Add extra flags if provided
if env.get('EXTRA_CFLAGS'):
    base_cflags.extend(env['EXTRA_CFLAGS'].split())

# ESP32-specific include paths (avoid header clashes)
if is_esp32:
    # Include paths with proper ordering to prevent clashes
    env.Append(CPPPATH=[
        OPUS_SRC_DIR,
        OPUS_SRC_DIR + '/include',
        OPUS_SRC_DIR + '/celt',
        OPUS_SRC_DIR + '/silk',
        OPUS_SRC_DIR + '/silk/fixed',
    ])
    # Ensure system headers don't override Opus headers
    env.Append(CPPPATH=['.', OPUS_SRC_DIR])
else:
    env.Append(CPPPATH=[
        '.',
        OPUS_SRC_DIR,
        OPUS_SRC_DIR + '/include',
        OPUS_SRC_DIR + '/celt',
        OPUS_SRC_DIR + '/silk',
        OPUS_SRC_DIR + '/silk/fixed',
    ])

# Set compiler flags
env.Append(CCFLAGS=base_cflags)

config_header = '''
#include <alloca.h>
#define OPUS_BUILD 1
#define HAVE_LRINT 1
#define HAVE_LRINTF 1
#define HAVE_MEMORY_H 1
#define HAVE_STDINT_H 1
#define HAVE_STDLIB_H 1
#define HAVE_STRING_H 1
'''

with open('config.h', 'w') as f:
    f.write(config_header)

env.Append(CPPDEFINES=['HAVE_CONFIG_H'])
env.Append(CPPPATH=['.'])

# Linker flags
env.Append(LINKFLAGS=['-lm'])

# Source files to compile
opus_sources = [
